{
	"doctype": "DocType",
	"name": "iShop Item",
	"module": "LogicX iShop",
	"autoname": "field:item_code",
	"track_changes": 1,
	"track_views": 1,
	"is_submittable": 0,
	"allow_rename": 1,
	"allow_import": 1,
	"title_field": "item_name",
	"show_title_field_in_link": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"index_web_pages_for_search": 1,
	"grid_page_length": 50,
	"fields": [
		{
			"fieldname": "details_section",
			"fieldtype": "Section Break"
		},
		{
			"label": "ERPNext Item",
			"fieldname": "erpnext_item",
			"fieldtype": "Link",
			"options": "Item",
			"unique": 1
		},
		{
			"label": "Item Code",
			"fieldname": "item_code",
			"fieldtype": "Data",
			"reqd": 1,
			"unique": 1
		},
		{
			"label": "Item Name",
			"fieldname": "item_name",
			"fieldtype": "Data",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"label": "Availability",
			"fieldname": "availability",
			"fieldtype": "Select",
			"options": "Immediately\nTomorrow\nIn 2 days\nIn 3 days\nNot Available",
			"reqd": 1
		},
		{
			"label": "Item Group",
			"fieldname": "item_group",
			"fieldtype": "Link",
			"options": "Item Group",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"label": "Brand",
			"fieldname": "brand",
			"fieldtype": "Link",
			"options": "Brand",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"label": "Web Price",
			"fieldname": "web_price",
			"fieldtype": "Currency"
		},
		{
			"label": "MRP",
			"fieldname": "mrp",
			"fieldtype": "Currency"
		},
		{
			"label": "Highlights",
			"fieldname": "highlights",
			"fieldtype": "Data"
		},
		{
			"fieldname": "details_column",
			"fieldtype": "Column Break"
		},
		{
			"label": "Image Preview",
			"fieldname": "image_preview",
			"fieldtype": "HTML"
		},
		{
			"label": "Image",
			"fieldname": "image",
			"fieldtype": "Attach Image",
			"mandatory_depends_on": "eval:doc.published"
		},
		{
			"label": "Published",
			"fieldname": "published",
			"fieldtype": "Check",
			"default": "0",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "description_section",
			"fieldtype": "Section Break"
		},
		{
			"label": "Short Description",
			"fieldname": "short_description",
			"fieldtype": "Small Text",
			"mandatory_depends_on": "eval:doc.published"
		},
		{
			"label": "Full Description",
			"fieldname": "full_description",
			"fieldtype": "Text Editor"
		}
	],
	"permissions": [
		{
			"if_owner": 0,
			"permlevel": 0,
			"role": "TM User",
			"read": 1,
			"create": 1,
			"write": 1,
			"delete": 0,
			"select": 1,
			"report": 1,
			"export": 1,
			"email": 1,
			"print": 1,
			"share": 1,
			"import": 0,
			"mask": 0,
			"submit": 0,
			"cancel": 0,
			"amend": 0
		},
		{
			"if_owner": 0,
			"permlevel": 0,
			"role": "TM Admin",
			"read": 1,
			"create": 1,
			"write": 1,
			"delete": 1,
			"select": 1,
			"report": 1,
			"export": 1,
			"email": 1,
			"print": 1,
			"share": 1,
			"import": 1,
			"mask": 1,
			"submit": 0,
			"cancel": 0,
			"amend": 0
		},
		{
			"if_owner": 0,
			"permlevel": 1,
			"role": "LogicX iShop Manager",
			"read": 1,
			"write": 1,
			"mask": 1
		}
		,
		{
			"role": "System Manager",
			"read": 1,
			"create": 1,
			"write": 1,
			"delete": 1,
			"select": 1,
			"report": 1,
			"export": 1,
			"import": 1
		}
	]
}
