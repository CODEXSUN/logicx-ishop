{
	"doctype": "DocType",
	"name": "iShop Catalog",
	"module": "LogicX iShop",
	"autoname": "field:catalog_code",
	"track_changes": 1,
	"track_views": 1,
	"is_submittable": 0,
	"allow_rename": 1,
	"allow_import": 1,
	"title_field": "catalog_name",
	"show_title_field_in_link": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"index_web_pages_for_search": 1,
	"grid_page_length": 50,
	"fields": [
		{
			"label": "Catalog Code",
			"fieldname": "catalog_code",
			"fieldtype": "Data",
			"reqd": 1,
			"unique": 1,
			"in_list_view": 1
		},
		{
			"label": "Catalog Name",
			"fieldname": "catalog_name",
			"fieldtype": "Data",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"label": "Description",
			"fieldname": "description",
			"fieldtype": "Small Text",
			"mandatory_depends_on": "eval:doc.published"
		},
		{
			"label": "Catalog Image",
			"fieldname": "catalog_image",
			"fieldtype": "Attach Image",
			"mandatory_depends_on": "eval:doc.published"
		},
		{
			"label": "Published",
			"fieldname": "published",
			"fieldtype": "Check",
			"default": "0",
			"in_list_view": 1
		},
		{
			"label": "Catalog Items",
			"fieldname": "catalog_items",
			"fieldtype": "Table",
			"options": "Catalog Item",
			"mandatory_depends_on": "eval:doc.published"
		}
	],
	"permissions": [
