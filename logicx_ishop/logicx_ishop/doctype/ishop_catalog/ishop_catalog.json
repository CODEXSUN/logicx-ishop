			"mask": 0,
			"submit": 0,
			"cancel": 0,
			"amend": 0
		},
		{
			"if_owner": 0,
			"permlevel": 0,
			"role": "TM Admin",
			"read": 1,
			"create": 1,
			"write": 1,
			"delete": 1,
			"select": 1,
			"report": 1,
			"export": 1,
			"email": 1,
			"print": 1,
			"share": 1,
			"import": 1,
			"mask": 1,
			"submit": 0,
			"cancel": 0,
			"amend": 0
		},
		{
